{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "layout": { "contentSize": "760px", "wideSize": "1200px" },
    "color": {
      "palette": [
        { "slug": "brand", "name": "Brand", "color": "#1F6FEB" },
        { "slug": "ink", "name": "Ink", "color": "#0A0A0A" },
        { "slug": "muted", "name": "Muted", "color": "#6B7280" },
        { "slug": "paper", "name": "Paper", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "sm", "size": "0.95rem" },
        { "slug": "base", "size": "1rem" },
        { "slug": "lg", "size": "1.125rem" },
        { "slug": "xl", "size": "2.25rem" },
        { "slug": "xxl", "size": "3rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)" }
  },
  "customTemplates": [
    { "name": "page-landing", "title": "Landing Page", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "patterns": [
    { "name": "rfm/hero", "title": "Hero", "categories": ["pages"] },
    { "name": "rfm/features", "title": "Features", "categories": ["pages"] },
    { "name": "rfm/proof", "title": "Proof", "categories": ["pages"] },
    { "name": "rfm/pricing", "title": "Pricing", "categories": ["pages"] },
    { "name": "rfm/contact", "title": "Contact", "categories": ["pages"] }
  ]
}
